# Kopieren nach .env und Werte setzen. .env niemals committen.

# Postgres (POSTGRES_* werden nur beim allerersten Start mit leerem Datenverzeichnis übernommen!)
POSTGRES_USER=shermadmin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shermmap

# Lokal: localhost. Passwort ohne Sonderzeichen wie @ : / (steht in der URL)
DATABASE_URL=postgres://shermadmin:change-me@localhost:5432/shermmap

# Mindestens 32 Zeichen, z.B. mit: openssl rand -hex 32
JWT_SECRET=

# Admin wird nur angelegt, wenn es den User noch nicht gibt. Passwort mind. 12 Zeichen.
ADMIN_USER=admin
ADMIN_PASS=

PORT=3000
# Anzahl Reverse Proxies vor dem Server (Traefik = 1, lokal 0)
TRUST_PROXY=0
