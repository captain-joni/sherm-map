# Kopieren nach .env und Werte setzen. .env niemals committen.

# Postgres (POSTGRES_* werden nur beim allerersten Start mit leerem Datenverzeichnis übernommen!)
# Passwort ohne Sonderzeichen wie @ : / (es steht in der Verbindungs-URL)
POSTGRES_USER=shermadmin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shermmap

# Geheimnis für pseudonyme IP-/Geräte-Hashes, mind. 32 Zeichen: openssl rand -hex 32
# Nicht mehr ändern, sonst passen alte Hashes (Spam-Erkennung, Likes) nicht mehr
HASH_SECRET=

# Öffentliche Adresse der App (Origin-Prüfung, Link-Vorschauen)
PUBLIC_URL=https://map.sherm.fun

# Erster Admin, wird nur angelegt, wenn es noch keinen User mit dem Namen gibt (Passwort mind. 12 Zeichen).
# Danach kann das hier leer bleiben; weitere User legt man im Admin-Panel an.
ADMIN_USER=admin
ADMIN_PASS=

# Ordner auf dem Host (Defaults wie auf dem Prod-Server)
# PGDATA_DIR=/opt/nfs/sherm-map/pgdata
# UPLOADS_DIR=/opt/nfs/sherm-map/uploads
# BACKUP_DIR=./backups

# Nur für lokale Entwicklung ohne Docker (npm run dev -w backend):
# DATABASE_URL=postgres://shermadmin:change-me@localhost:5432/shermmap
# TRUST_PROXY=0

# --- Backups (scripts/backup.sh, restore-test.sh) ---
# Zielordner der Backups, relativ = relativ zum Repo. Am besten NICHT auf demselben Speicher wie pgdata.
# BACKUP_DIR=./backups
# KEEP_DAILY=7
# KEEP_WEEKLY=4
# KEEP_MONTHLY=6
# Befehl nach jedem erfolgreichen Backup, bekommt den Dateipfad als $1 (z.B. Kopie auf ein anderes Laufwerk)
# BACKUP_POST_HOOK='cp "$1" /mnt/usb-backup/'

# --- Benachrichtigungen (Webhook, z.B. n8n) ---
# Backups/Restore-Tests melden Fehler hierhin; das Backend meldet neue Sherms und Meldungen.
# NOTIFY_WEBHOOK_URL=https://n8n.example.org/webhook/sherm-map
# NOTIFY_WEBHOOK_TOKEN=
# Auch erfolgreiche Backups melden (für einen "seit 26 h kein Backup"-Alarm in n8n)
# BACKUP_NOTIFY_SUCCESS=true

